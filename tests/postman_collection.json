{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
    "name": "Autonomous CI/CD Healing Agent API",
    "description": "Postman collection for the Autonomous CI/CD Healing Agent backend.\n\nBase URL: {{base_url}} — default: http://localhost:8000\n\nEndpoints:\n  GET  /health            Health check\n  GET  /auth/login        Start GitHub OAuth flow\n  GET  /auth/callback     GitHub OAuth exchange (called by GitHub)\n  POST /run-agent         Trigger the full multi-agent workflow\n\nHow to use:\n1. Import this collection into Postman.\n2. Set collection variable `github_token` to a valid GitHub PAT (scope: repo).\n3. Run the requests in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "github_token",
      "value": "YOUR_GITHUB_PAT_HERE",
      "type": "string",
      "description": "GitHub Personal Access Token with `repo` scope. Use /auth/login to get one via OAuth."
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] },
            "description": "Verify the server is up."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body is healthy', () => pm.expect(pm.response.json().status).to.eql('healthy'));",
                  "pm.test('Response time < 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"status\": \"healthy\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "2. GitHub OAuth",
      "item": [
        {
          "name": "GET /auth/login",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "description": "Redirects browser to GitHub OAuth authorize page.\nRequires GITHUB_CLIENT_ID set in backend .env"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Not a server error', () => pm.expect(pm.response.code).to.not.equal(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/callback — No Code (Error)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/auth/callback", "host": ["{{base_url}}"], "path": ["auth", "callback"] },
            "description": "Calling without `code` param returns 400."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error detail present', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "400 Bad Request",
              "status": "Bad Request",
              "code": 400,
              "body": "{\"detail\": \"No code provided\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "3. Run Agent",
      "item": [
        {
          "name": "POST /run-agent — Happy Path",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"repository_url\": \"https://github.com/your-org/buggy-repo.git\",\n    \"github_token\": \"{{github_token}}\",\n    \"team_name\": \"DevionCrew\",\n    \"team_leader\": \"Pankaj Sagvekar\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/run-agent", "host": ["{{base_url}}"], "path": ["run-agent"] },
            "description": "Triggers the full workflow:\n1. Clone repo (authenticated with github_token)\n2. Create branch: TEAMNAME_TEAMLEADER_AI_FIX\n3. Run pytest in Docker\n4. Analyze failures with Gemini AI\n5. Apply AI fixes and commit [AI-AGENT] prefix\n6. Return score and results"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('All required fields present', () => {",
                  "    const j = pm.response.json();",
                  "    ['repository_url','team_name','leader_name','branch_name',",
                  "     'total_failures','total_fixes','iterations_used','commit_count',",
                  "     'final_status','total_time_seconds','score_calculation']",
                  "    .forEach(k => pm.expect(j).to.have.property(k));",
                  "});",
                  "",
                  "pm.test('final_status is PASSED or FAILED', () =>",
                  "    pm.expect(['PASSED','FAILED']).to.include(pm.response.json().final_status));",
                  "",
                  "pm.test('branch_name follows TEAM_LEADER_AI_FIX format', () =>",
                  "    pm.expect(pm.response.json().branch_name).to.match(/^[A-Z0-9_]+_AI_FIX$/));",
                  "",
                  "pm.test('score_calculation has all 4 keys', () => {",
                  "    const sc = pm.response.json().score_calculation;",
                  "    ['base_score','speed_bonus','efficiency_penalty','final_score']",
                  "    .forEach(k => pm.expect(sc).to.have.property(k));",
                  "});",
                  "",
                  "pm.test('base_score is 100', () =>",
                  "    pm.expect(pm.response.json().score_calculation.base_score).to.eql(100));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK — PASSED",
              "status": "OK",
              "code": 200,
              "body": "{\n    \"repository_url\": \"https://github.com/your-org/buggy-repo.git\",\n    \"team_name\": \"DevionCrew\",\n    \"leader_name\": \"Pankaj Sagvekar\",\n    \"branch_name\": \"DEVIONCREW_PANKAJ_SAGVEKAR_AI_FIX\",\n    \"total_failures\": 2,\n    \"total_fixes\": 2,\n    \"iterations_used\": 2,\n    \"commit_count\": 2,\n    \"final_status\": \"PASSED\",\n    \"total_time_seconds\": 178.42,\n    \"score_calculation\": {\n        \"base_score\": 100,\n        \"speed_bonus\": 10,\n        \"efficiency_penalty\": 0,\n        \"final_score\": 110\n    }\n}"
            }
          ]
        },
        {
          "name": "POST /run-agent — Missing repository_url",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"github_token\": \"gho_mock\",\n    \"team_name\": \"DevionCrew\",\n    \"team_leader\": \"Pankaj Sagvekar\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/run-agent", "host": ["{{base_url}}"], "path": ["run-agent"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /run-agent — Missing github_token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"repository_url\": \"https://github.com/org/repo.git\",\n    \"team_name\": \"DevionCrew\",\n    \"team_leader\": \"Pankaj Sagvekar\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/run-agent", "host": ["{{base_url}}"], "path": ["run-agent"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422 for missing github_token', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /run-agent — Missing team_name",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"repository_url\": \"https://github.com/org/repo.git\",\n    \"github_token\": \"gho_mock\",\n    \"team_leader\": \"Pankaj Sagvekar\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/run-agent", "host": ["{{base_url}}"], "path": ["run-agent"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422 for missing team_name', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /run-agent — Missing team_leader",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"repository_url\": \"https://github.com/org/repo.git\",\n    \"github_token\": \"gho_mock\",\n    \"team_name\": \"DevionCrew\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/run-agent", "host": ["{{base_url}}"], "path": ["run-agent"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422 for missing team_leader', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /run-agent — Empty Body",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/run-agent", "host": ["{{base_url}}"], "path": ["run-agent"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "pm.test('All 4 required fields reported', () =>",
                  "    pm.expect(pm.response.json().detail.length).to.be.at.least(4));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
